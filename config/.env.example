# LLM Configuration
LLM_PROVIDER=anthropic  # Options: anthropic, openai
API_KEY=your-api-key-here
BASE_URL=  # Optional: for local LLM servers (e.g., http://localhost:8080/v1)
MODEL_NAME=YOUR_MODEL_IDENTIFIER  # e.g. provider-specific model ID

# Agent Configuration
AUTO_APPROVE_RENAMES=false
MAX_TOOL_CALLS=100
AGENT_TIMEOUT=300

# Service URLs (all services run in the single backend container)
WORKER_URL=http://localhost:8001

# Storage
DATA_DIR=/app/data
MAX_UPLOAD_SIZE_MB=100

# Ghidra Configuration
GHIDRA_VERSION=12.1
GHIDRA_ANALYSIS_TIMEOUT=300

# Security
SAFE_MODE=false
ENABLE_NETWORKING=false
WORKER_CPU_LIMIT=2
WORKER_MEM_LIMIT=4g

# Display
DISPLAY_TIMEZONE=America/Los_Angeles  # Timezone for reports/UI (IANA name). Storage always uses UTC.

# Script Hooks (GB-23)
DISABLE_HOOKS=false

# Logging
LOG_LEVEL=INFO
